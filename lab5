CREATE TABLE STUDENT(
regno varchar(15),
name varchar(15),
major varchar(15),
bdate date,
PRIMARY KEY (regno)
);

CREATE TABLE COURSE(
course int,
cname varchar(15),
dept varchar(15),
PRIMARY KEY (course));

CREATE TABLE TEXT(
book_isbn int,
booktitle varchar(15),
publisher varchar(15),
author varchar(15),
PRIMARY KEY (book_isbn)
);

CREATE TABLE ENROLL(
regno varchar(15),
course int,
sem int,
book_isbn int,
PRIMARY KEY (regno,course,book_isbn),
FOREIGN KEY (regno) REFERENCES STUDENT (regno) ON DELETE CASCADE,
FOREIGN KEY (course) REFERENCES COURSE (course) ON DELETE CASCADE,
FOREIGN KEY (book_isbn) REFERENCES TEXT (book_isbn) ON DELETE CASCADE
);

CREATE TABLE BOOK_ADOPTION(
course int,
book_isbn int,
sem int,
PRIMARY KEY (course,book_isbn),
FOREIGN KEY (course) REFERENCES COURSE (course) ON DELETE CASCADE,
FOREIGN KEY (book_isbn) REFERENCES TEXT (book_isbn) ON DELETE CASCADE
);



